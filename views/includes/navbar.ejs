<style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    :root {
      --sky: #1a6b8a; --sand: #e8c97a; --white: #ffffff; --dark: #0f2a36; --nav-h: 68px;
    }
    body { font-family: 'DM Sans', sans-serif; }
    nav {
      background: var(--white); border-bottom: 1px solid #dde8ec; height: var(--nav-h);
      display: grid;
      grid-template-columns: 1fr auto 1fr;
      align-items: center;
      padding: 0 2rem; position: sticky; top: 0; z-index: 100;
    }
    .logo { font-size: 1.50rem; color: var(--sky); text-decoration: none; font-weight: 600; }
    .logo span { color: var(--sand); }
    .nav-right { display: flex; align-items: center; gap: 0.5rem; list-style: none; margin-left: auto; }
    .nav-right a { text-decoration: none; font-size: 0.9rem; font-weight: 500; color: var(--dark); padding: 0.45rem 0.75rem; border-radius: 6px; }
    .nav-right a:hover { background: #eaf4f8; color: var(--sky); }

    .btn-login { background: var(--sky); color: var(--white) !important; border-radius: 8px; padding: 0.45rem 1.1rem !important; }
    .btn-login:hover { background: var(--dark) !important; color: var(--white) !important; }
    .btn-logout { background: #e74c3c; color: var(--white) !important; border-radius: 8px; padding: 0.45rem 1.1rem !important; }
    .btn-logout:hover { background: var(--dark) !important; color: var(--white) !important; }

    /* ── Dropdown ── */
    .dropdown { position: relative; }
    .dropdown-trigger {
      display: flex; align-items: center; gap: 0.4rem;
      cursor: pointer; padding: 0.45rem 0.75rem;
      border-radius: 6px; font-size: 0.9rem; font-weight: 500; color: var(--dark);
      user-select: none;
    }
    .dropdown-trigger:hover { background: #eaf4f8; color: var(--sky); }
    .dropdown-trigger .avatar {
      width: 30px; height: 30px; background: var(--sky); color: white;
      border-radius: 50%; display: flex; align-items: center; justify-content: center;
      font-size: 0.8rem; font-weight: 600;
    }
    .dropdown-menu {
      display: none; position: absolute; right: 0; top: calc(100% + 8px);
      background: var(--white); border: 1px solid #dde8ec;
      border-radius: 10px; min-width: 180px;
      box-shadow: 0 4px 16px rgba(0,0,0,0.1); z-index: 200;
      overflow: hidden;
    }
    .dropdown-menu a {
      display: block; padding: 0.65rem 1rem;
      font-size: 0.88rem; color: var(--dark); text-decoration: none;
    }
    .dropdown-menu a:hover { background: #eaf4f8; color: var(--sky); }
    .dropdown-menu .divider { border-top: 1px solid #eee; margin: 0.25rem 0; }
    .dropdown-menu .logout-link { color: #e74c3c !important; }
    .dropdown-menu .logout-link:hover { background: #fdf0f0 !important; }
    .dropdown.open .dropdown-menu { display: block; }

    /* ── Hamburger ── */
    .hamburger { display: none; flex-direction: column; gap: 5px; cursor: pointer; margin-left: auto; padding: 6px; background: none; border: none; }
    .hamburger span { display: block; width: 24px; height: 2px; background: var(--dark); border-radius: 2px; }
    .mobile-menu { display: none; flex-direction: column; background: var(--white); border-top: 1px solid #dde8ec; padding: 0.75rem 1.5rem 1.25rem; gap: 0.25rem; }
    .mobile-menu a { text-decoration: none; font-size: 0.95rem; font-weight: 500; color: var(--dark); padding: 0.6rem 0; border-bottom: 1px solid #f0f4f6; }
    .mobile-menu a:last-child { border-bottom: none; }
    .mobile-menu .btn-login { background: var(--sky); color: var(--white) !important; padding: 0.6rem 1rem; border-radius: 8px; text-align: center; margin-top: 0.5rem; }
    .mobile-menu .btn-logout { background: #e74c3c; color: var(--white) !important; padding: 0.6rem 1rem; border-radius: 8px; text-align: center; margin-top: 0.5rem; }
    @media (max-width: 720px) {
      .nav-right { display: none; }
      .hamburger { display: flex; }
      .mobile-menu.open { display: flex; }
    }
</style>

<nav>
  <!-- Left: Logo -->
  <a href="/listings" class="logo">🌐 Wander<span>lust</span></a>

  <!-- Center: Search -->
  <form method="GET" action="/listings" style="display:flex; align-items:center; gap:0.4rem;">
    <div style="position:relative;">
      <i data-lucide="search" style="position:absolute; left:9px; top:50%; transform:translateY(-50%); width:15px; height:15px; color:#aaa; pointer-events:none;"></i>
      <input
        type="text"
        name="q"
        placeholder="Search listings…"
        value="<%= typeof currentFilters !== 'undefined' ? (currentFilters.q || '') : '' %>"
        style="padding: 0.45rem 0.9rem 0.45rem 2rem; border: 1.5px solid #ddd; border-radius: 20px; font-size: 0.85rem; outline: none; width: 220px;"
      />
    </div>
    <button type="submit" style="background:#1a6b8a; color:white; border:none; border-radius:20px; padding:0.45rem 1rem; font-size:0.85rem; cursor:pointer;">
      Search
    </button>
  </form>

  <!-- Right: Nav links -->
  <ul class="nav-right">
    <% if (typeof currUser !== 'undefined' && currUser) { %>
      <li><a href="/listings/new" class="btn-login">+ Add Listing</a></li>

      <!-- ✅ Dropdown for user menu -->
      <li class="dropdown" id="userDropdown">
        <div class="dropdown-trigger" onclick="toggleDropdown()">
          <div class="avatar"><%= currUser.username.charAt(0).toUpperCase() %></div>
          <%= currUser.username %>
        </div>
        <div class="dropdown-menu">
          <a href="/bookings/my">📅 My Bookings</a>
          <a href="/bookings/owner">📋 Booking Requests</a>
          <div class="divider"></div>
          <a href="/logout" class="logout-link">🚪 Logout</a>
        </div>
      </li>

    <% } else { %>
      <li><a href="/register" class="btn-login">Register</a></li>
      <li><a href="/login" class="btn-login">Login</a></li>
    <% } %>
  </ul>

  <button class="hamburger" onclick="toggleMenu()" aria-label="Toggle menu">
    <span></span><span></span><span></span>
  </button>
</nav>

<div class="mobile-menu" id="mobileMenu">
  <a href="/">Home</a>
  <a href="/listings">Listings</a>
  <% if (typeof currUser !== 'undefined' && currUser) { %>
    <a href="/listings/new" class="btn-login">+ Add Listing</a>
    <a href="/bookings/my">📅 My Bookings</a>
    <a href="/bookings/owner">📋 Booking Requests</a>
    <span style="font-size:0.9rem; color:#777; padding:0.6rem 0;">👤 <%= currUser.username %></span>
    <a href="/logout" class="btn-logout">Logout</a>
  <% } else { %>
    <a href="/register" class="btn-login">Register</a>
    <a href="/login" class="btn-login">Login</a>
  <% } %>
</div>

<script>
  function toggleMenu() {
    document.getElementById('mobileMenu').classList.toggle('open');
  }

  function toggleDropdown() {
    document.getElementById('userDropdown').classList.toggle('open');
  }

  // Close dropdown when clicking outside
  document.addEventListener('click', function(e) {
    const dropdown = document.getElementById('userDropdown');
    if (dropdown && !dropdown.contains(e.target)) {
      dropdown.classList.remove('open');
    }
  });
</script>
<% layout('layouts/boilerplate') %>

<link rel="stylesheet" href="/css/rating.css">

<style>
  .show-container {
    max-width: 700px;
    margin: 2rem auto;
    background: #fff;
    border-radius: 14px;
    overflow: hidden;
    box-shadow: 0 2px 12px rgba(0,0,0,0.08);
  }

  .show-container img {
    width: 100%;
    height: 350px;
    object-fit: cover;
  }

  .show-body {
    padding: 1.5rem 2rem;
  }

  .show-body h1 {
    font-size: 1.6rem;
    color: #0f2a36;
    margin-bottom: 0.5rem;
  }

  .show-body .location {
    font-size: 0.9rem;
    color: #777;
    margin-bottom: 0.75rem;
  }

  .show-body .price {
    font-size: 1.1rem;
    font-weight: 700;
    color: #1a6b8a;
    margin-bottom: 1rem;
  }

  .show-body .description {
    font-size: 0.95rem;
    color: #444;
    line-height: 1.6;
    margin-bottom: 1.5rem;
  }

  .show-actions {
    display: flex;
    gap: 0.75rem;
  }

  .btn-edit {
    background: #e8c97a;
    color: #0f2a36;
    padding: 0.6rem 1.2rem;
    border: none;
    border-radius: 8px;
    font-size: 0.9rem;
    font-weight: 600;
    cursor: pointer;
    text-decoration: none;
  }

  .btn-edit:hover { background: #0f2a36; color: white; }

  .back-link {
    display: inline-block;
    color: #1a6b8a;
    text-decoration: none;
    font-size: 0.9rem;
    padding: 0.6rem 1.2rem;
    border: 1px solid #1a6b8a;
    border-radius: 8px;
  }

  .back-link:hover { background: #1a6b8a; color: white; }

  .review-form-container {
    max-width: 700px;
    margin: 2rem auto;
    background: #fff;
    border-radius: 14px;
    padding: 1.5rem 2rem;
    box-shadow: 0 2px 12px rgba(0,0,0,0.08);
  }

  .review-form-container h2 {
    font-size: 1.2rem;
    color: #0f2a36;
    margin-bottom: 1rem;
  }

  .review-form-container label {
    font-size: 0.85rem;
    color: #555;
    display: block;
    margin-bottom: 0.3rem;
  }

  .btn-review {
    background: #1a6b8a;
    color: white;
    padding: 0.6rem 1.4rem;
    border: none;
    border-radius: 8px;
    font-size: 0.9rem;
    font-weight: 600;
    cursor: pointer;
  }

  .btn-review:hover { background: #0f2a36; }

  .starability-basic > input:focus + label {
    outline: none !important;
  }

  /* ===== MAP ===== */
  #map {
    height: 300px;
    width: 100%;
    border-radius: 10px;
    margin-top: 1.2rem;
    margin-bottom: 1.5rem;
    z-index: 0 !important;
    position: relative;
  }

  .map-label {
    font-size: 0.9rem;
    font-weight: 600;
    color: #0f2a36;
    margin-bottom: 0.4rem;
  }
</style>

<!-- Listing Card -->
<div class="show-container">
  <img src="<%= listing.image && listing.image.url ? listing.image.url : listing.image %>" alt="listing image"/>
  <div class="show-body">
    <h1><%= listing.title %></h1>
    <p class="location">📍 <%= listing.location %>, <%= listing.country %></p>
    <p class="price">₹<%= listing.price %> / night</p>
    <p class="description"><%= listing.description %></p>

    <!-- MAP -->
    <p class="map-label">🗺️ Where you'll be</p>
    <div id="map"></div>

    <p style="font-size:0.85rem; color:#777;">
      Owner: <strong><%= listing.owner ? listing.owner.username : "Unknown" %></strong>
    </p>
    <div class="show-actions">
      <a href="/listings" class="back-link">← Back</a>
      <% if (typeof currUser !== 'undefined' && currUser && listing.owner && !listing.owner.equals(currUser._id)) { %>
        <a href="/bookings/<%= listing._id %>/new" class="btn-edit" style="background:#1a6b8a; color:white;">Book Now</a>
      <% } %>
      <% if (typeof currUser !== 'undefined' && currUser && listing.owner && listing.owner.equals(currUser._id)) { %>
        <a href="/listings/<%= listing._id %>/edit" class="btn-edit">Edit</a>
        <form action="/listings/<%= listing._id %>?_method=DELETE" method="POST" style="margin:0;">
          <button type="submit" style="background:#e8c97a; color:#0f2a36; padding:0.6rem 1.2rem; border:none; border-radius:8px; font-size:0.9rem; font-weight:600; cursor:pointer;">Delete</button>
        </form>
      <% } %>
    </div>
  </div>
</div>

<!-- Review Form -->
<% if (typeof currUser !== 'undefined' && currUser) { %>
<div class="review-form-container">
  <h2>Leave a Review</h2>
  <!-- ✅ added needs-validation + onsubmit rating check -->
  <form action="/listings/<%= listing._id %>/reviews" method="POST" class="needs-validation" novalidate
        onsubmit="const sel = document.querySelector('input[name=\'review[rating]\']:checked'); if (!sel || sel.value == 0) { alert('Please select a star rating!'); return false; }">

    <label>Your Rating</label>
    <fieldset class="starability-basic">
      <input type="radio" id="no-rate" class="input-no-rate" name="review[rating]" value="0" aria-label="No rating"/> <!-- ✅ removed checked -->
      <input type="radio" id="first-rate1" name="review[rating]" value="1"/>
      <label for="first-rate1">&nbsp;</label>
      <input type="radio" id="first-rate2" name="review[rating]" value="2"/>
      <label for="first-rate2">&nbsp;</label>
      <input type="radio" id="first-rate3" name="review[rating]" value="3"/>
      <label for="first-rate3">&nbsp;</label>
      <input type="radio" id="first-rate4" name="review[rating]" value="4"/>
      <label for="first-rate4">&nbsp;</label>
      <input type="radio" id="first-rate5" name="review[rating]" value="5"/>
      <label for="first-rate5">&nbsp;</label>
    </fieldset>

    <div class="mb-3">
      <label>Comment</label>
      <textarea name="review[comment]" rows="4" placeholder="Share your experience..." class="form-control" required></textarea>
      <div class="invalid-feedback">Please write a comment.</div>
    </div>

    <button class="btn-review" type="submit">Submit Review</button>

  </form>
</div>
<% } else { %>
<div class="review-form-container">
  <p style="text-align:center; color:#777; font-size:0.95rem;">
    <a href="/login" style="color:#1a6b8a; font-weight:600;">Login</a> to leave a review.
  </p>
</div>
<% } %>

<script>
  (function() {
    'use strict';
    window.addEventListener('load', function() {
      var forms = document.getElementsByClassName('needs-validation');
      Array.prototype.filter.call(forms, function(form) {
        form.addEventListener('submit', function(event) {
          if (form.checkValidity() === false) {
            event.preventDefault();
            event.stopPropagation();
          }
          form.classList.add('was-validated');
        }, false);
      });
    }, false);
  })();
</script>

<!-- All Reviews -->
<% if (listing.reviews.length > 0) { %>
<div class="review-form-container">
  <h2>All Reviews</h2>
  <% for (let review of listing.reviews) { %>
  <div style="border:1px solid #eee; border-radius:10px; padding:1rem; margin-bottom:1rem;">
    <div style="display:flex; justify-content:space-between; align-items:center;">
      <strong style="color:#0f2a36;"><%= review.reviewer %></strong>
      <p class="starability-result" data-rating="<%= review.rating %>">
        Rating: <%= review.rating %>
      </p>
    </div>
    <p style="color:#444; font-size:0.9rem; margin-top:0.5rem;"><%= review.comment %></p>
    <% if (typeof currUser !== 'undefined' && currUser && review.author && currUser._id.equals(review.author)) { %>
      <form action="/listings/<%= listing._id %>/reviews/<%= review._id %>?_method=DELETE" method="POST" style="margin:0;">
        <button type="submit" style="background:#e74c3c; color:white; padding:0.4rem 0.9rem; border:none; border-radius:6px; font-size:0.8rem; cursor:pointer;">Delete</button>
      </form>
    <% } %>
  </div>
  <% } %>
</div>
<% } %>

<!-- Pass location to map.js -->
<script>
  const listingLocation = "<%= listing.location %>, <%= listing.country %>";
</script>
<!-- ✅ removed duplicate map.js script tag (already loaded in boilerplate) -->

<% layout('layouts/boilerplate') %>
<% const filters = locals.currentFilters || {}; %>

<style>
  .filter-section {
    max-width: 1200px;
    margin: 1.5rem auto 0;
    padding: 0 2rem;
  }

  .filter-bar {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    flex-wrap: wrap;
    justify-content: center;
    margin-bottom: 1.5rem;
    padding: 0.5rem 0.75rem;
  }

  .cat-btn {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 2px;
    padding: 0.4rem 0.9rem;
    border: none;
    border-radius: 30px;
    background: transparent;
    cursor: pointer;
    font-size: 0.72rem;
    font-weight: 500;
    color: #555;
    text-decoration: none;
    transition: all 0.18s;
    white-space: nowrap;
  }

  .cat-btn i { width: 16px; height: 16px; stroke-width: 1.8; }
  .cat-btn:hover, .cat-btn.active { background: #0f2a36; color: #fff; }
  .cat-btn:hover i, .cat-btn.active i { stroke: #fff; }

  .cards-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 1.5rem;
    padding: 0 2rem 2rem;
    max-width: 1200px;
    margin: 0 auto;
  }

  .card {
    border-radius: 14px;
    overflow: hidden;
    background: #fff;
    box-shadow: 0 2px 8px rgba(0,0,0,0.08);
    transition: transform 0.2s, box-shadow 0.2s;
    cursor: pointer;
    position: relative;
  }

  .card-link { position: absolute; inset: 0; z-index: 0; }

  .card:hover {
    transform: translateY(-5px);
    box-shadow: 0 8px 24px rgba(0,0,0,0.13);
  }

  .card img { width: 100%; height: 200px; object-fit: cover; }

  .card-body {
    padding: 0.85rem 1rem;
    position: relative;
    z-index: 1;
  }

  .card-body h3 { font-size: 1rem; font-weight: 600; color: #0f2a36; margin-bottom: 0.25rem; }
  .card-body .location { font-size: 0.85rem; color: #777; margin-bottom: 0.4rem; }
  .card-body .price { font-size: 0.95rem; font-weight: 600; color: #1a6b8a; }

  .no-results {
    text-align: center;
    padding: 3rem;
    color: #777;
    font-size: 1rem;
    grid-column: 1/-1;
  }
</style>


<div class="filter-section">
  <div class="filter-bar">
    <% const categories = [
      { label: "All",       icon: "home",          value: "" },
      { label: "Beach",     icon: "umbrella",      value: "beach" },
      { label: "Mountain",  icon: "mountain-snow", value: "mountain" },
      { label: "City",      icon: "building-2",    value: "city" },
      { label: "Camping",   icon: "tent",          value: "camping" },
      { label: "Castle",    icon: "castle",        value: "castle" },
      { label: "Lakefront", icon: "waves",         value: "lakefront" },
      { label: "Skiing",    icon: "snowflake",     value: "skiing" },
      { label: "Tropical",  icon: "palmtree",      value: "tropical" },
    ]; %>
    <% for (let cat of categories) { %>
      <a href="?category=<%= cat.value %>"
         class="cat-btn <%= filters.category === cat.value || (!filters.category && cat.value === '') ? 'active' : '' %>">
        <i data-lucide="<%= cat.icon %>"></i>
        <%= cat.label %>
      </a>
    <% } %>
  </div>
</div>

<!-- ── LISTINGS GRID ── -->
<div class="cards-grid">
  <% if (allListings.length === 0) { %>
    <div class="no-results">No listings found. Try different filters.</div>
  <% } %>
  <% for (let listing of allListings) { %>
  <div class="card">
    <a href="/listings/<%= listing._id %>" class="card-link"></a>
    <img src="<%= listing.image && listing.image.url ? listing.image.url : listing.image %>" alt="listing image"/>
    <div class="card-body">
      <h3><%= listing.title %></h3>
      <p class="location"><%= listing.location %>, <%= listing.country %></p>
      <p class="price">₹<%= listing.price %> / night</p>
    </div>
  </div>
  <% } %>
</div>

<script>
  document.addEventListener("DOMContentLoaded", () => {
    lucide.createIcons();
  });
</script>